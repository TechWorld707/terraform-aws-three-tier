# Terraform working files and state
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Python virtual environments and cache
.venv/
venv/
.test-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local tooling and generated reports
.tflint.d/
.infracost/
checkov-report*
trivy-report*
# Local Terraform backend configuration
**/backend.hcl
# Reusable modules inherit provider locks from root modules
modules/**/.terraform.lock.hcl
